import java.util.Scanner;
class Tempconversion{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int choice;
        double celcius, farenheit;
        System.out.println("TEMP CONVERSION");
        System.out.println("1.celcius to farenheit ");
        System.out.print("2.fahrenheit to celcius");

        System.out.print("Enter your choice(1 or 2):  ");
        choice = sc.nextInt();

        if(choice == 1){
            System.out.println("Enter temperature in celcius: ");
            celcius = sc.nextDouble();
            farenheit = (celcius*9/5) + 32;
            System.out.printf("Temperature in fahrenheit is : %.2fF" ,farenheit);

        }
        else if(choice == 2) {
          System.out.println("Enter temperature in farenheit: ");
            farenheit = sc.nextDouble();
            celcius = (farenheit - 32) * 5/9;
            System.out.printf("Temperature in celsius is : %.2fC" ,celcius);  

        }
        else{
            System.out.println("Invalid choice");

        }
        sc.close();
    }
}
