import java.util.Random;
import java.util.Scanner;
class Main{
    public static void main(String[]args){
        Random random = new Random();
        Scanner sc = new Scanner(System.in);
        int guess=0;
        int min=0;
        int max=100;
        int attempts =0;
        int randomNumber = random.nextInt(min,max + 1);
        System.out.println("---- GUESSING NUMBER GAME ----");
        do{
            System.out.print("Guess a number  between (1 - 100): ");
            if(!sc.hasNextInt()){
            System.out.println("Number must be in numeric form!");
           sc.next();
           continue;
            }
            guess = sc.nextInt();
            if(guess < min || guess > max){
                System.out.println("Enter number in the above mentioned range !");
                continue;
            }
        attempts++;
        if(guess < randomNumber){
            System.out.println(" TOO LOW,TRY BIG!");
        }else if(guess > randomNumber){
            System.out.println("TOO BIG,TRY SMALL!"); 
        }else{
            System.out.println("CORRECT " +guess+ " is the required number.");
        }
        }while(guess != randomNumber);
        System.out.println("No.of attemps taken for guessing is  : "+attempts);
        
        sc.close();
    }
}
